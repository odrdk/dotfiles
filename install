#!/usr/bin/env bash
# Instala estes dotfiles no Arch. Pode rodar de novo sem estragar nada.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKUP="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
CONFIG="$HOME/.config"

passo() { printf '\n==> %s\n' "$1"; }
pacotes() { grep -v '^#' "$1" | xargs -n1 echo; }

[ "$(id -u)" -ne 0 ] || { echo "Rode como usuário comum, não como root."; exit 1; }

# Arquivo real vai para o backup; link antigo é só trocado.
liga() {
  local origem="$1" destino="$2"
  mkdir -p "$(dirname "$destino")"
  if [ -e "$destino" ] && [ ! -L "$destino" ]; then
    mkdir -p "$BACKUP"
    mv "$destino" "$BACKUP/"
  fi
  ln -sfn "$origem" "$destino"
}

passo "Pacotes oficiais"
pacotes "$REPO/pacotes/oficial.txt" | sudo pacman -S --needed --noconfirm -

passo "yay"
if ! command -v yay >/dev/null; then
  tmp="$(mktemp -d)"
  git clone https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin"
  (cd "$tmp/yay-bin" && makepkg -si --noconfirm)
  rm -rf "$tmp"
fi

passo "Pacotes do AUR"
pacotes "$REPO/pacotes/aur.txt" | xargs -o yay -S --needed --noconfirm --sudoloop --answerdiff None --answerclean None --removemake

passo "Oh My Zsh"
[ -d "$CONFIG/.oh-my-zsh" ] || git clone --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$CONFIG/.oh-my-zsh"

passo "Links"
for f in .Xresources .xinitrc .zshenv; do
  liga "$REPO/$f" "$HOME/$f"
done
for d in zsh suckless nvim picom ranger xmenu wal mpv mpd ncmpcpp cmus redshift sxiv xsettingsd; do
  liga "$REPO/.config/$d" "$CONFIG/$d"
done
find "$REPO/.local/bin" -maxdepth 1 -type f -print0 | while IFS= read -r -d '' f; do
  chmod +x "$f"
  liga "$f" "$HOME/.local/bin/$(basename "$f")"
done
chmod +x "$REPO"/.local/bin/statusbar/*
liga "$REPO/.local/bin/statusbar" "$HOME/.local/bin/statusbar"
liga "$REPO/.config/xmenu/xmenu.sh" "$HOME/.local/bin/menu"

# Estes quatro são gerados pelo pywal; ficam vazios até o primeiro wal -i.
liga "$HOME/.cache/wal/dunstrc" "$CONFIG/dunst/dunstrc"
liga "$HOME/.cache/wal/flameshot.ini" "$CONFIG/flameshot/flameshot.ini"
liga "$HOME/.cache/wal/config" "$CONFIG/cava/config"
liga "$HOME/.cache/wal/zathurarc" "$CONFIG/zathura/zathurarc"

mkdir -p "$HOME/Pictures/wallpapers" "$HOME/Music" "$CONFIG/mpd/playlists"
xdg-user-dirs-update

passo "Compilar suckless"
for p in dwm st dmenu slock; do
  rm -f "$REPO/.config/suckless/$p/config.h"
  make -C "$REPO/.config/suckless/$p" clean all
  sudo make -C "$REPO/.config/suckless/$p" install
done
make -C "$REPO/.config/suckless/dwmblocks-async" clean all
sudo make -C "$REPO/.config/suckless/dwmblocks-async" install
make -C "$REPO/.config/xmenu"
sudo make -C "$REPO/.config/xmenu" install

passo "Touchpad"
sudo mkdir -p /etc/X11/xorg.conf.d
sudo cp "$REPO/pacotes/90-touchpad.conf" /etc/X11/xorg.conf.d/90-touchpad.conf

passo "Serviços"
sudo systemctl enable --now NetworkManager bluetooth

passo "Shell"
[ "$(getent passwd "$USER" | cut -d: -f7)" = /usr/bin/zsh ] || chsh -s /usr/bin/zsh

passo "Navegador padrão"
xdg-settings set default-web-browser brave-browser.desktop || true

passo "Cores"
# Sem X ainda: gera os arquivos do pywal e deixa o .xinitrc aplicar.
cp -n "$REPO/img/raven.png" "$HOME/Pictures/wallpapers/" || true
[ -e "$HOME/.cache/wal/colors" ] || wal -n -e -s -t -i "$HOME/Pictures/wallpapers/raven.png" || true

[ ! -d "$BACKUP" ] || echo "Arquivos antigos em $BACKUP"
echo "Pronto."
